# Скопіюй у .env і заповни два обов'язкові значення. Решта має робочі дефолти.

# --- Обов'язкові ---

# Токен бота: Telegram → @BotFather → /newbot
TELEGRAM_BOT_TOKEN=

# Ключ Groq: https://console.groq.com/keys
GROQ_API_KEY=

# --- Необов'язкові (показано значення за замовчуванням) ---

# База даних; у docker compose — сервіс db
# DATABASE_URL=postgresql+asyncpg://forest:forest@db:5432/forest

# Логи: DEBUG | INFO | WARNING | ERROR; формат text | json
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# Часовий пояс для «сьогодні» й днів тижня у відповідях
# BOT_TIMEZONE=Europe/Kyiv

# Код запрошення (t.me/<бот>?start=<код>); порожньо — згенерується й з'явиться в лозі
# INVITE_CODE=

# Ліміти документів: розмір файлу, МБ; документів від одного звіра за годину
# MAX_FILE_MB=20
# UPLOADS_PER_HOUR=20

# «Лісовий архів» на Google Диску: id теки й інтервал синхронізації, с
# ARCHIVE_FOLDER_ID=1b_hEjnkQfP8ZVP-OEbnYWqoGSFwXMAP3
# ARCHIVE_SYNC_INTERVAL=900

# Моделі Groq через кому: основна, далі запасні
# GROQ_MODELS=

# Роль процесу: all | bot | worker
# ROLE=all
