# Текст — завжди LF: dev на Windows, а CRLF у .sh ламає контейнер
* text=auto eol=lf

# Бінарні формати
*.pdf  binary
*.doc  binary
*.docx binary
*.odt  binary
*.rtf  binary
*.png  binary
*.jpg  binary
*.gif  binary
*.onnx binary

# Байти як на Google Диску: зміни архіву визначаються за sha256
data/archive/** -text
examples/**     -text
# Фікстури парсерів: cp1251, CRLF — саме те, що надсилають звірі
tests/fixtures/formats/** -text
